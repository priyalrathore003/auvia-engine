# Twilio telephony bridge (telephony/twilio_bridge.py, /voice, /twilio-stream)
#
# PUBLIC_WS_URL is the only variable this bridge actually reads tonight — it's
# the wss:// URL used to build the <Stream> TwiML, i.e. your ngrok tunnel's
# WebSocket path. Get an ngrok URL by running `ngrok http 8000` (see README),
# then set this to that host + /twilio-stream.
PUBLIC_WS_URL=wss://your-ngrok-subdomain.ngrok-free.dev/twilio-stream

# Reserved, not yet consumed by any code path: the TwiML webhook at /voice is
# currently unauthenticated (see telephony/twilio_bridge.py module docstring
# for why signature validation was deliberately deferred, not skipped
# silently). These are here so the shape is documented before that lands.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Per-turn latency instrumentation (telephony/latency_events.py) — POSTs
# events to a locally-running voice-latency-harness instance
# (github.com/priyalrathore003/voice-latency-harness). Fire-and-forget: if
# either of these is unset, emit_event() logs a warning and drops the event
# rather than blocking the call. AUVIA_WEBHOOK_SECRET must match the same
# value set in that repo's own .env (AUVIA_WEBHOOK_SECRET there too).
LATENCY_HARNESS_URL=http://localhost:8099
AUVIA_WEBHOOK_SECRET=replace-with-a-shared-secret-matching-voice-latency-harness/.env
